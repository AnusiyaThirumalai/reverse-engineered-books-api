APP_ENV=development
LOG_LEVEL=INFO

# Cache for fetched pages (seconds). 0 disables caching.
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=512

# Outbound (to the target website)
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
UPSTREAM_MIN_INTERVAL_SECONDS=0.2

# Inbound (per client, protects the target site from amplification)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Listing pages scanned per search (20 books/page)
SEARCH_MAX_PAGES=10
